{% if collections.latestPosts.length > 0 %}
<section class="sec" id="writing">
  <div class="container sec__inner">
    <div class="sec__head reveal">
      <span class="sec__no">03</span>
      <span class="sec__name">Recent Writing</span>
      <span class="sec__rule" aria-hidden="true"></span>
    </div>

    <h2 class="sec__title reveal r1">最新文章 — <em>Field Notes</em></h2>

    <div class="post-previews reveal r1">
      {% for post in collections.latestPosts %}
      <a href="{{ post.url }}" class="post-preview">
        <time class="post-preview__date" datetime="{{ post.date | isoDate }}">{{ post.date | shortDate }}</time>
        <h3 class="post-preview__title">{{ post.data.title }}</h3>
        <p class="post-preview__desc">{{ post.data.description }}</p>
        <div class="post-preview__tags">
          {% for tag in post.data.tags %}
          {% if tag != "posts" %}
          <span class="tag">{{ tag }}</span>
          {% endif %}
          {% endfor %}
        </div>
      </a>
      {% endfor %}
    </div>

    <p class="sec__more reveal r2">
      <a href="/blog/" class="btn">查看全部文章 →</a>
    </p>
  </div>
</section>
{% endif %}

