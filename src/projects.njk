    <article class="spec reveal r1">
      <div class="spec__head">
        <span class="spec__no">02</span>
        <div class="spec__titlebox">
          <h3 class="spec__name">ServicePioneer 移动端</h3>
          <p class="spec__role">独立开发 · React Native + Expo</p>
        </div>
        <span class="spec__stamp">■ Deployed</span>
